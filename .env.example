# --- HiveMQ Cloud (copy this file to .env and fill in) ---
MQTT_BROKER=YOUR_CLUSTER.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_TOPIC=factory/machine01/rotating

# --- Optional Telegram alerts (leave blank to print alerts in the terminal only) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=120
